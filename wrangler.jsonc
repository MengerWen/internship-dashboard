{
  "name": "internship-dashboard",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-07",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ACCESS_ISSUER": "https://mengerwenjie.cloudflareaccess.com",
    "ACCESS_AUD": "4f1a77c1070db3b13ba049fd6d29a792bed71b628c6b3f5b7ab7d3815617da4d",
    "TAG_EDITORS": "*"
  },
  "durable_objects": {"bindings": [{"name": "REPORT_TAGS", "class_name": "ReportTags"}]},
  "migrations": [{"tag": "report-tags-v1", "new_sqlite_classes": ["ReportTags"]}]
}
