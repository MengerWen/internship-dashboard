+def test_direct_object_publication_uses_namespace_without_mount_metadata(tmp_path, monkeypatch):
+    mount = tmp_path / "mount"
+    source = tmp_path / "local.parquet"
+    source.write_bytes(b"complete immutable object")
+    target = mount / "outputs/new/day.parquet"
+    publisher = ObjectPublication(str(mount), "company/bucket")
+    objects = {}
+    resolve, mkdir = Path.resolve, Path.mkdir
+
+    def owned_namespace(path):
+        return path == mount or mount in path.parents
+
+    def resolve_local(path, *args, **kwargs):
+        if owned_namespace(path):
+            raise AssertionError("object locator must not resolve through the mount")
+        return resolve(path, *args, **kwargs)
+
+    def mkdir_local(path, *args, **kwargs):
+        if owned_namespace(path):
+            raise AssertionError("object upload must not create mount directories")
+        return mkdir(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "resolve", resolve_local)
+    monkeypatch.setattr(Path, "mkdir", mkdir_local)
+    monkeypatch.setattr(ObjectPublication, "upload", lambda self, src, dst:
+        objects.__setitem__(self.target(dst), src.read_bytes()))
+    monkeypatch.setattr(ObjectPublication, "readback_sha256", lambda self, dst:
+        hashlib.sha256(objects[self.target(dst)]).hexdigest())
+    digest = publish_file(source, target, object_publication=publisher, remove_source=True)
+    assert digest == hashlib.sha256(b"complete immutable object").hexdigest()
+    assert objects == {"company/bucket/outputs/new/day.parquet": b"complete immutable object"}
+    assert not source.exists()
+    with pytest.raises(ValueError):
+        publisher.target(mount / ".." / "outside")
+
