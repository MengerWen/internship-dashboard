+from __future__ import annotations
+
+import pandas as pd
+
+from algobench.event_prestate import (
+    attach_lagged_opponent_depth,
+    build_depth_checkpoints,
+)
+from algobench.event_windows import canonicalize_event_block, split_event_windows
+
+
+DAY = "2026-04-01"
+
+
+def _event(seq: int, time: str, etype: str, **values) -> dict[str, object]:
+    row = {
+        "channel_no": 1,
+        "seq": seq,
+        "ts": pd.Timestamp(f"{DAY} {time}"),
+        "etype": etype,
+        "code": "000001",
+        "side": "",
+        "price_tick": 0,
+        "qty": 0,
+        "order_id": 0,
+        "bid_id": 0,
+        "ask_id": 0,
+        "ord_type": "",
+    }
+    row.update(values)
+    return row
+
+
+def _windows():
+    events = pd.DataFrame(
+        [
+            _event(1, "09:29:59.000", "order", order_id=1, side="B", price_tick=99, qty=100, ord_type="L"),
+            _event(2, "09:29:59.100", "order", order_id=2, side="S", price_tick=101, qty=200, ord_type="L"),
+            _event(3, "09:29:59.200", "order", order_id=3, side="S", price_tick=102, qty=300, ord_type="L"),
+            _event(4, "09:30:00.000", "order", order_id=4, side="B", price_tick=101, qty=200, ord_type="L"),
+            _event(5, "09:30:00.000", "trade", bid_id=4, ask_id=2, price_tick=101, qty=50),
+            _event(6, "09:30:00.100", "cancel", order_id=2, qty=50),
+            _event(7, "09:30:00.200", "order", order_id=7, side="S", price_tick=100, qty=75, ord_type="L"),
+        ]
+    )
+    return split_event_windows(canonicalize_event_block(events))
+
+
+def _order(seq: int = 4, ts: str = "09:30:00.000") -> pd.DataFrame:
+    return pd.DataFrame(
+        {
+            "date": [DAY],
+            "code": ["000001"],
+            "channel_no": [1],
+            "side": ["B"],
+            "submit_seq": [seq],
+            "submit_ts": [pd.Timestamp(f"{DAY} {ts}")],
+            "submit_qty": [200],
+        }
+    )
+
+
+def test_second_level_prices_follow_channel_sequence() -> None:
+    checkpoints = build_depth_checkpoints(_windows())
+    before = checkpoints.loc[checkpoints["seq"].eq(3)].iloc[0]
+    after = checkpoints.loc[checkpoints["seq"].eq(7)].iloc[0]
+    assert (before["best_ask_tick"], before["second_ask_tick"]) == (101, 102)
+    assert (after["best_ask_tick"], after["second_ask_tick"]) == (100, 101)
+
+
+def test_lagged_depth_uses_state_effective_at_target_time() -> None:
+    result = attach_lagged_opponent_depth(
+        _order(ts="09:30:00.200"), build_depth_checkpoints(_windows()), offsets_ms=[-100, 0]
+    )
+    assert result.loc[0, "opponent_best_qty_lag_m100ms"] == 100
+    assert result.loc[0, "opponent_best_qty_lag_z0ms"] == 100
+
+
+def test_lagged_depth_does_not_use_nearest_order_snapshot() -> None:
+    result = attach_lagged_opponent_depth(
+        _order(ts="09:30:00.150"), build_depth_checkpoints(_windows()), offsets_ms=[0]
+    )
+    assert result.loc[0, "opponent_best_qty_lag_z0ms"] == 100
+
+
+def test_same_timestamp_is_resolved_by_event_sequence() -> None:
+    result = attach_lagged_opponent_depth(
+        _order(seq=5), build_depth_checkpoints(_windows()), offsets_ms=[0]
+    )
+    assert result.loc[0, "opponent_best_qty_lag_z0ms"] == 200
+
+
+def test_future_offsets_are_marked_descriptive_only() -> None:
+    result = attach_lagged_opponent_depth(
+        _order(), build_depth_checkpoints(_windows()), offsets_ms=[-100, 100]
+    )
+    assert not result.loc[0, "lag_descriptive_only_lag_m100ms"]
+    assert result.loc[0, "lag_descriptive_only_lag_p100ms"]
+    assert result.attrs["positive_offsets_descriptive_only"] is True
+
+
+def test_missing_history_and_missing_second_level_are_explicit() -> None:
+    checkpoints = build_depth_checkpoints(_windows())
+    result = attach_lagged_opponent_depth(_order(), checkpoints, offsets_ms=[-5000, 0])
+    assert not result.loc[0, "lag_observable_lag_m5000ms"]
+    assert pd.isna(result.loc[0, "opponent_best_qty_lag_m5000ms"])
+    one_level = checkpoints.loc[checkpoints["seq"].eq(2)].iloc[0]
+    assert pd.isna(one_level["second_ask_tick"])
