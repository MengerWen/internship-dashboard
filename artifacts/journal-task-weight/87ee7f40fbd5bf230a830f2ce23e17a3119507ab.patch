diff --git a/因子/algobench/tests/test_historical_empty_inventory.py b/因子/algobench/tests/test_historical_empty_inventory.py
new file mode 100644
index 00000000..30b158b0
--- /dev/null
+++ b/因子/algobench/tests/test_historical_empty_inventory.py
@@ -0,0 +1,54 @@
+from pathlib import Path
+import json
+
+import pandas as pd
+import pytest
+
+from algobench.formal_evaluation_specs import default_factor_window_spec
+from algobench.historical_baselines import (
+    BASELINE_KINDS, BaselineBuildConfig, HistoricalObservationResult,
+    baseline_kind_statuses, build_hist_observation_primitives,
+    write_hist_observations, write_frozen_hist_baseline_manifest,
+    _load_frozen_hist_baseline_store,
+)
+
+
+def test_empty_inventory_publishes_only_omission_manifests_and_roundtrips(tmp_path):
+    window = default_factor_window_spec()
+    result = HistoricalObservationResult(
+        *(pd.DataFrame() for _ in BASELINE_KINDS), window, ())
+    written = write_hist_observations(result, tmp_path / "observations")
+    assert len(written) == 1 and written[0].name == "MANIFEST.json"
+    observed = json.loads(written[0].read_text(encoding="utf-8"))
+    assert observed["tables"] == {} and observed["baseline_kinds"] == []
+    assert observed["excluded_baseline_kinds"] == list(BASELINE_KINDS)
+    assert all(value["status"] == "omitted" for value in observed["baseline_kind_status"].values())
+    write_frozen_hist_baseline_manifest(output_root=tmp_path, window_spec=window,
+        config=BaselineBuildConfig(), artifacts={})
+    assert _load_frozen_hist_baseline_store(str(tmp_path), window.window_id,
+        window.output_token, window.spec_hash) == ({}, {})
+    assert not list(tmp_path.rglob("*.parquet"))
+
+
+def test_empty_computation_request_still_fails_before_reading_inputs():
+    with pytest.raises(ValueError, match="cannot be empty"):
+        build_hist_observation_primitives(pd.DataFrame(), pd.DataFrame(), pd.DataFrame(),
+            window_spec=default_factor_window_spec(), included_kinds=())
+    for invalid in (("unknown",), ("activity", "activity")):
+        with pytest.raises(ValueError):
+            baseline_kind_statuses(invalid)
+
+
+def test_baseline_free_cli_does_not_read_observations_or_liquidity(tmp_path, monkeypatch):
+    import build_hist_observations as command
+    root = Path(__file__).resolve().parents[3]
+    def forbidden(*args, **kwargs):
+        raise AssertionError("baseline-free study must not read observation data")
+    monkeypatch.setattr(pd, "read_parquet", forbidden)
+    assert command.main(["--output-root", str(tmp_path),
+        "--registry", str(root / "PLAN/factor_preregister_2026q2_logic.yaml"),
+        "--window-id", default_factor_window_spec().window_id,
+        "--liquidity-membership", str(tmp_path / "absent.parquet")]) == 0
+    manifests = list(tmp_path.rglob("MANIFEST.json"))
+    assert len(manifests) == 1
+    assert json.loads(manifests[0].read_text(encoding="utf-8"))["tables"] == {}
