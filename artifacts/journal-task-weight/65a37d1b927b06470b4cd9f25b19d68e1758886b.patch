+
+
+def test_scheduler_passes_channel_evidence_to_the_real_consumer(monkeypatch, tmp_path):
+    from concurrent.futures import ThreadPoolExecutor
+    from snapshot.scheduler import DailyScheduler, SchedulerSettings, ConsumerOutput
+    import snapshot.query_plan as gateway
+    monkeypatch.setattr(gateway, 'iter_raw_day_by_code', lambda *a, **kw: iter(source_items()))
+    plan = QueryPlan.for_research('2026-06-30', ['000001', '000002'], tables=('order', 'trade', 'cancel'),
+        data_time_upper_bound='2026-06-30 09:35:00')
+    scheduler = DailyScheduler(SchedulerSettings.from_env(extract_workers=1, compute_workers=1,
+        compute_queue_depth=1, parser_threads_per_stream=1, materialized_day_limit=1),
+        streaming_loader=iter_channel_closed_inputs, compute_executor_factory=ThreadPoolExecutor)
+    seen = []
+    def consume(item):
+        block = build_calibration_event_block(item.order, item.trade, item.cancel,
+            date=item.date, code=item.code, include_preopen_context=True)
+        actual = replay_plan_for_input(block, item)
+        validate_replay_plan(ReplayOptions.corrected(), actual, events=block.frame)
+        seen.append(item.code)
+        return ConsumerOutput()
+    scheduler.register('closure_check', consume)
+    result = scheduler.run([plan], manifest_path=tmp_path/'scheduler.jsonl')
+    assert sorted(seen) == ['000001', '000002']
+    assert all(row.status == 'done' for row in result.tasks)
