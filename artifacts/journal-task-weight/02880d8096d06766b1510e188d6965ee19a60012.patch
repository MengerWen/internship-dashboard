+    current_metrics.read_rows = 0
+    current_metrics.retained_rows = 0
+    current_metrics.discarded_rows = 0
+    current_metrics.bytes_read = 0
+    current_metrics.first_row_seconds = 0.0
+    current_metrics.elapsed_seconds = 0.0
+    started = time.perf_counter()
+    sql = build_select_sql(spec)
+    process = popen_factory(
+        _mysql_command(login_path=login_path, database=database),
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        bufsize=0,
+    )
+    if process.stdin is None or process.stdout is None or process.stderr is None:
+        _terminate_process(process)
+        raise DorisQueryError("mysql subprocess did not expose all required pipes")
+
+    stderr_drain = _StderrDrain(process.stderr)
+    stderr_drain.start()
+    counting = _CountingRaw(io.BufferedReader(process.stdout, buffer_size=1 << 20), started=started)
+    completed = False
+    parts: list[pd.DataFrame] = []
+    try:
+        process.stdin.write((sql + "\n").encode("utf-8"))
+        process.stdin.close()
+        frames = (
