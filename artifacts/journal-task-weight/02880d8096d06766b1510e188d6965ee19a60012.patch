+        raise ValueError("load_table_code_range requires a code-range spec")
+    if "code" not in spec.columns:
+        raise ValueError("load_table_code_range requires the code column")
+    if backend not in {"pyarrow", "pandas"}:
+        raise ValueError("backend must be 'pyarrow' or 'pandas'")
