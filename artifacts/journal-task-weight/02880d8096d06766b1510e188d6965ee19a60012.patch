+def seconds_until_doris_allowed(now: datetime | None = None) -> float:
+    """Return how long a new query must wait for the 08:50-09:35 window to end."""
+
+    moment = (now or _beijing_now()).astimezone(BEIJING)
+    start, end = DORIS_QUIET_WINDOW
+    if not start <= moment.time() < end:
+        return 0.0
+    resume = moment.replace(
+        hour=end.hour, minute=end.minute, second=0, microsecond=0
+    )
+    return (resume - moment).total_seconds()
+
+
+def wait_for_doris_window(
+    *,
+    sleep: Callable[[float], None] | None = None,
+) -> float:
+    """Block until queries are allowed; return the seconds spent waiting."""
+
+    sleep = sleep or time.sleep
+    waited = 0.0
+    announced = False
+    while (remaining := seconds_until_doris_allowed()) > 0:
+        if not announced:
+            print(
+                "Doris queries paused until 09:35 Beijing time "
+                f"({remaining:.0f}s)",
+                file=sys.stderr,
+                flush=True,
+            )
+            announced = True
+        step = min(remaining, 60.0)
+        sleep(step)
+        waited += step
+    return waited
+
