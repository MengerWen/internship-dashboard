+                arrow_threads=arrow_threads,
+                block_size=int(parser_block_size),
+            )
+            if backend == "pyarrow"
+            else _iter_pandas_frames(counting, spec.columns)
+        )
+        parts = [frame for frame in frames if not frame.empty]
+        completed = True
