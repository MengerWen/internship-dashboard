+def _iter_code_range_pages(
+    plan: QueryPlan,
+    *,
+    backend: ParserBackend,
+    popen_factory: PopenFactory | None,
+    arrow_threads: int | None,
+    telemetry_sink: TelemetrySink | None,
+    peak_rss_reader: Callable[[], int],
+) -> Iterator[RawCodeFrames]:
+    """Query one code-range page at a time and release its stocks in code order.
+
+    Within a page at most ``plan.table_parallelism`` tables are queried at
+    once. One loader thread fetches the next page while the caller consumes the
+    current one, so at most two pages of raw rows are resident.
+    """
+
+    pages = plan.code_range_pages()
+    tables = tuple(TABLE_COLUMNS)
+    loaded: Queue[tuple[str, object, object, object]] = Queue(maxsize=1)
+    stop = threading.Event()
+
+    def put(item: tuple[str, object, object, object]) -> None:
+        while not stop.is_set():
+            try:
+                loaded.put(item, timeout=0.1)
+                return
+            except Full:
+                continue
+
+    def load(spec: DorisQuerySpec) -> tuple[dict[str, pd.DataFrame], StreamMetrics]:
+        metrics = StreamMetrics()
+        kwargs: dict[str, object] = {
+            "backend": backend,
+            "arrow_threads": arrow_threads,
+            "metrics": metrics,
+            "peak_rss_reader": peak_rss_reader,
+        }
+        if popen_factory is not None:
+            kwargs["popen_factory"] = popen_factory
+        return load_table_code_range(spec, **kwargs), metrics
+
+    def produce() -> None:
+        executor = (
+            ThreadPoolExecutor(
+                max_workers=plan.table_parallelism,
+                thread_name_prefix="doris-code-range",
+            )
+            if plan.table_parallelism > 1
+            else None
+        )
+        try:
+            for page in pages:
+                specs = [plan.code_range_spec(table, page) for table in tables]
+                results = []
+                if executor is None:
+                    for spec in specs:
+                        if stop.is_set():
+                            return
+                        results.append(load(spec))
+                else:
+                    if stop.is_set():
+                        return
+                    futures = [executor.submit(load, spec) for spec in specs]
+                    results = [future.result() for future in futures]
+                put(("page", page, specs, results))
+            put(("done", None, None, None))
+        except BaseException as exc:  # noqa: BLE001 - relay exact query failure.
+            put(("error", exc, None, None))
+        finally:
+            if executor is not None:
+                executor.shutdown(wait=True, cancel_futures=True)
