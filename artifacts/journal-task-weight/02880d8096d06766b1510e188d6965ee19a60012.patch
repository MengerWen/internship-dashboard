+def _fake_page_loader(table_codes, calls, *, active=None, delay=0.0):
+    def load(spec, **kwargs):
+        if active is not None:
+            with active["lock"]:
+                active["now"] += 1
+                active["max"] = max(active["max"], active["now"])
+        try:
+            if delay:
+                time.sleep(delay)
+            calls.append((spec.table, spec.code_range))
+            metrics = kwargs["metrics"]
+            frames = {}
+            for code in spec.codes:
+                if code in table_codes[spec.table]:
+                    frames[code] = pd.DataFrame(
+                        {column: [code if column == "code" else 1] for column in spec.columns}
+                    )
+            metrics.rows = metrics.retained_rows = len(frames)
+            metrics.read_rows = len(frames) + 1
+            metrics.discarded_rows = 1
+            metrics.bytes_read = 10 * len(frames)
+            metrics.first_row_seconds = 0.5
+            metrics.elapsed_seconds = 1.0
+            return frames
+        finally:
+            if active is not None:
+                with active["lock"]:
+                    active["now"] -= 1
+
+    return load
+
