diff --git a/因子/algobench/src/algobench/formal_real_data_calibration.py b/因子/algobench/src/algobench/formal_real_data_calibration.py
index 55f9f18d..a563747a 100644
--- a/因子/algobench/src/algobench/formal_real_data_calibration.py
+++ b/因子/algobench/src/algobench/formal_real_data_calibration.py
@@ -58,2 +58,20 @@ STRUCTURAL_EVENT_PRESTATE_LEGS = ("order", "trade_bid", "cancel")
 
+_STRUCTURAL_WORKER_CONSUMER = None
+
+
+def initialize_structural_calibration_worker(consumer):
+    """每个计算进程只接收一次冻结配置和股票元数据。"""
+    global _STRUCTURAL_WORKER_CONSUMER
+    _STRUCTURAL_WORKER_CONSUMER = consumer
+
+
+@dataclass(frozen=True)
+class StructuralCalibrationWorker:
+    """逐股任务只传输输入，完整消费者由进程初始化器持有。"""
+
+    def __call__(self, item):
+        if _STRUCTURAL_WORKER_CONSUMER is None:
+            raise RuntimeError("structural calibration worker is not initialized")
+        return _STRUCTURAL_WORKER_CONSUMER(item)
+
 
diff --git a/因子/algobench/tests/test_structural_calibration_worker.py b/因子/algobench/tests/test_structural_calibration_worker.py
new file mode 100644
index 00000000..7cc9ff19
--- /dev/null
+++ b/因子/algobench/tests/test_structural_calibration_worker.py
@@ -0,0 +1,52 @@
+from concurrent.futures import ProcessPoolExecutor
+from dataclasses import dataclass, field
+import multiprocessing
+import pickle
+
+import pytest
+
+from algobench.formal_real_data_calibration import (
+    StructuralCalibrationWorker,
+    initialize_structural_calibration_worker,
+)
+
+
+@dataclass
+class CountingConsumer:
+    metadata: dict = field(default_factory=lambda: {str(i): i for i in range(2863)})
+    calls: int = 0
+
+    def __call__(self, item):
+        self.calls += 1
+        return item, self.metadata[str(item)], self.calls
+
+
+def test_worker_requires_initialized_consumer(monkeypatch):
+    import algobench.formal_real_data_calibration as module
+    monkeypatch.setattr(module, "_STRUCTURAL_WORKER_CONSUMER", None)
+    with pytest.raises(RuntimeError, match="not initialized"):
+        StructuralCalibrationWorker()(0)
+
+
+@pytest.mark.parametrize("method", ["spawn", "fork"])
+def test_worker_reuses_initialized_state_for_multiple_stock_tasks(method):
+    if method not in multiprocessing.get_all_start_methods():
+        pytest.skip("process start method is unavailable")
+    consumer = CountingConsumer()
+    with ProcessPoolExecutor(
+        max_workers=1,
+        mp_context=multiprocessing.get_context(method),
+        initializer=initialize_structural_calibration_worker,
+        initargs=(consumer,),
+    ) as pool:
+        results = list(pool.map(StructuralCalibrationWorker(), [0, 1, 2]))
+    assert results == [(0, 0, 1), (1, 1, 2), (2, 2, 3)]
+    assert consumer.calls == 0
+
+
+def test_each_task_transfers_compact_worker_descriptor():
+    consumer = CountingConsumer()
+    worker = StructuralCalibrationWorker()
+    assert len(pickle.dumps(worker)) < 256
+    assert len(pickle.dumps(consumer)) > 20_000
+    assert isinstance(pickle.loads(pickle.dumps(worker)), StructuralCalibrationWorker)
