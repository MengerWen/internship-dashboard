+@pytest.mark.parametrize('completion', ['scored', 'static_skip', 'no_evidence_orders'])
+def test_stock_day_releases_phase_state_and_preserves_results_without_cyclic_gc(monkeypatch, completion):
+    from test_formal_engine import _single_logic_engine, _load_document
+    from algobench.formal_scorers import build_formal_scorer_registry
+
+    instances = []
+    original = module._StockDayExecution.run
+    def observe(execution):
+        instances.append(weakref.ref(execution))
+        return original(execution)
+    monkeypatch.setattr(module._StockDayExecution, 'run', observe)
+    if completion == 'static_skip':
+        engine = module.FormalFactorEngine(
+            catalog=module.PreregisterCatalog.from_document(_load_document()),
+            scorer_registry=build_formal_scorer_registry(), config=module.EngineConfig(phase='score'))
+    else:
+        engine = _single_logic_engine(artifacts=frozenset({Artifact.LIFECYCLE, Artifact.PRESTATE}))
+    enabled = gc.isenabled()
+    gc.disable()
+    try:
+        results = []
+        for code in ['000001', '000002']:
+            events = normalized(sweeping_limit())
+            events['code'] = code
+            if completion == 'no_evidence_orders':
+                events = events.iloc[:1].copy()
+                events['ts'] = pd.Timestamp('2026-06-30 10:30:00')
+            result = engine.run_stock_day(events)
+            results.append(result)
+            assert len(instances) == len(results)
+            assert all(reference() is None for reference in instances)
+            assert result.row.code.tolist() == [code]
+            if completion == 'no_evidence_orders':
+                assert {item.reason for item in result.telemetry} == {'no_evidence_orders'}
+            elif completion == 'static_skip':
+                assert {item.status for item in result.telemetry} == {'skipped'}
+            else:
+                assert result.row[list(result.formal_columns)].notna().any(axis=None)
+        assert results[0].row.code.tolist() == ['000001']
+    finally:
+        if enabled:
+            gc.enable()
