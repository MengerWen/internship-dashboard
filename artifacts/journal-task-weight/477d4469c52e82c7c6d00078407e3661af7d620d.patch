+def test_verified_bucket_staging_is_released_before_next_component(short_tmp_path, monkeypatch):
+    import algobench.formal_day_buckets as buckets
+    from algobench.prescreen_runtime import publish_file as publish
+    scratch, output = short_tmp_path / "s", short_tmp_path / "o"
+    fragments = _fragments(scratch, "bounded", "000001")
+    calls = []
+    def bounded_publish(source, target, **kwargs):
+        staged = list((scratch / "day-bucket-publication").rglob("*.parquet"))
+        assert staged == [source]
+        assert all(Path(fragment.path).is_file() for fragment in fragments)
+        calls.append(str(target))
+        return publish(source, target, **kwargs)
+    monkeypatch.setattr(buckets, "publish_file", bounded_publish)
+    merge_day_fragments(fragments, output_root=output, scratch_root=scratch, date=DAY,
