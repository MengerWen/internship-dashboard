diff --git a/因子/algobench/tests/test_formal_day_manifest_codec.py b/因子/algobench/tests/test_formal_day_manifest_codec.py
new file mode 100644
index 00000000..b220d211
--- /dev/null
+++ b/因子/algobench/tests/test_formal_day_manifest_codec.py
@@ -0,0 +1,79 @@
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from algobench.formal_day_manifest_codec import pack_day_manifest, restore_day_manifest, POOL_KEY, HEADER_REF, SCOPE_REF
+from algobench.formal_exactness import EXACTNESS_IDENTITY_SCHEMA_VERSION, identities_sha256
+from algobench.formal_panel import _atomic_write_json, _read_json, resolve_day_manifest
+
+
+def example():
+    identity = dict(schema_version=EXACTNESS_IDENTITY_SCHEMA_VERSION, rows=2,
+        columns=["order_id", "score", "来源"], dtypes={"order_id": "int64", "score": "float64", "来源": "object"},
+        values_sha256="a"*64, null_mask_sha256="b"*64)
+    scope = dict(feature_manifest_sha256="f"*64, output_dependencies=[dict(factor_id="买方", values=[2**63+1, None])])
+    return dict(date="2025-11-18", status="success", stock_day_exactness_evidence=[
+        dict(code="000001", input_tables={"order": deepcopy(identity)}),
+        dict(code="000002", response_winners={"winner": deepcopy(identity)})],
+        stock_proxy_bank_telemetry=[dict(code=code, feature_scope=deepcopy(scope)) for code in ("000001", "000002")],
+        floats=[-0., 1e-300, float("nan")])
+
+
+def test_pooled_manifest_preserves_all_scientific_content_and_independent_public_dicts():
+    value = example()
+    before = identities_sha256(value)
+    packed = pack_day_manifest(value)
+    assert identities_sha256(value) == before
+    assert len(packed[POOL_KEY]["exactness_headers"]) == 1
+    assert len(packed[POOL_KEY]["feature_scopes"]) == 1
+    restored = restore_day_manifest(json.loads(json.dumps(packed)))
+    assert identities_sha256(restored) == before
+    first = restored["stock_day_exactness_evidence"][0]["input_tables"]["order"]
+    second = restored["stock_day_exactness_evidence"][1]["response_winners"]["winner"]
+    first["columns"].clear()
+    first["dtypes"].clear()
+    assert second["columns"] and second["dtypes"]
+    restored["stock_proxy_bank_telemetry"][0]["feature_scope"]["output_dependencies"].clear()
+    assert restored["stock_proxy_bank_telemetry"][1]["feature_scope"]["output_dependencies"]
+    assert identities_sha256(value) == before
+
+
+@pytest.mark.parametrize("compressed", [False, True])
+def test_committed_public_readers_restore_pooled_and_legacy_content(tmp_path, compressed):
+    value = example()
+    path = tmp_path / ("day.json.gz" if compressed else "day.json")
+    digest = _atomic_write_json(value, path)
+    assert digest == hashlib.sha256(path.read_bytes()).hexdigest()
+    record = dict(date=value["date"], manifest_reference=dict(path=str(path), sha256=digest,
+        **({"compression": "gzip"} if compressed else {})))
+    assert identities_sha256(resolve_day_manifest(record)) == identities_sha256(value)
+    assert identities_sha256(_read_json(path)) == identities_sha256(value)
+    assert restore_day_manifest(value) is value
+    assert pack_day_manifest({"status": "success"}) == {"status": "success"}
+
+
+@pytest.mark.parametrize("fault", ["version", "header_hash", "scope_hash", "header_ref", "scope_ref", "missing_pool"])
+def test_pooled_manifest_rejects_changed_or_missing_content_references(fault):
+    packed = json.loads(json.dumps(pack_day_manifest(example())))
+    pool = packed[POOL_KEY]
+    if fault == "version": pool["schema_version"] = "unknown"
+    elif fault == "header_hash": next(iter(pool["exactness_headers"].values()))["columns"].reverse()
+    elif fault == "scope_hash": next(iter(pool["feature_scopes"].values()))["output_dependencies"].clear()
+    elif fault == "header_ref": packed["stock_day_exactness_evidence"][0]["input_tables"]["order"][HEADER_REF] = "0"*64
+    elif fault == "scope_ref": packed["stock_proxy_bank_telemetry"][0]["feature_scope"][SCOPE_REF] = "0"*64
+    else: del pool["exactness_headers"]
+    with pytest.raises(ValueError, match="day manifest"):
+        restore_day_manifest(packed)
+
+
+def test_changed_feature_scope_is_bound_separately_to_its_full_content():
+    value = example()
+    value["stock_proxy_bank_telemetry"][1]["feature_scope"]["output_dependencies"].append(dict(factor_id="sell"))
+    packed = pack_day_manifest(value)
+    assert len(packed[POOL_KEY]["feature_scopes"]) == 2
+    assert identities_sha256(restore_day_manifest(packed)) == identities_sha256(value)
+    with pytest.raises(ValueError, match="already contains"):
+        pack_day_manifest(packed)
