@@ -0,0 +1,102 @@
+"""日清单的内容寻址结构池；公开读取恢复完整科学内容。"""
+from __future__ import annotations
+
+import json
+
+from .formal_exactness import EXACTNESS_IDENTITY_SCHEMA_VERSION, identities_sha256
+
+POOL_KEY = "day_manifest_content_pool"
+POOL_SCHEMA = "formal-day-manifest-content-pool-v1"
+HEADER_REF = "exactness_schema_ref"
+SCOPE_REF = "feature_scope_ref"
+HEADER_KEYS = ("schema_version", "columns", "dtypes")
+
+
+def pack_day_manifest(value):
+    if "stock_day_exactness_evidence" not in value and "stock_proxy_bank_telemetry" not in value:
+        return value
+    if POOL_KEY in value:
+        raise ValueError("day manifest already contains an encoded content pool")
+    headers, scopes, header_cache, scope_cache = {}, {}, {}, {}
+
+    def pack(node):
+        if isinstance(node, dict):
+            if HEADER_REF in node or SCOPE_REF in node:
+                raise ValueError("day manifest contains a reserved content reference")
+            if node.get("schema_version") == EXACTNESS_IDENTITY_SCHEMA_VERSION:
+                key = (tuple(node["columns"]), tuple(node["dtypes"].items()))
+                digest = header_cache.get(key)
+                if digest is None:
+                    header = {name: node[name] for name in HEADER_KEYS}
+                    digest = identities_sha256(header)
+                    headers[digest] = header
+                    header_cache[key] = digest
+                return {**{name: item for name, item in node.items() if name not in HEADER_KEYS}, HEADER_REF: digest}
+            result = {}
+            for name, item in node.items():
+                if name == "feature_scope" and isinstance(item, dict):
+                    key = item.get("feature_manifest_sha256")
+                    cached = scope_cache.get(key)
+                    if cached is not None and cached[0] == item:
+                        digest = cached[1]
+                    else:
+                        digest = identities_sha256(item)
+                        scopes.setdefault(digest, item)
+                        scope_cache[key] = (item, digest)
+                    result[name] = {SCOPE_REF: digest}
+                else:
+                    result[name] = pack(item)
+            return result
+        if isinstance(node, list) and node and isinstance(node[0], (dict, list)):
+            return [pack(item) for item in node]
+        return node
+
+    packed = pack(value)
+    if headers or scopes:
+        packed[POOL_KEY] = dict(schema_version=POOL_SCHEMA, exactness_headers=headers, feature_scopes=scopes)
+    return packed
+
+
+def restore_day_manifest(value):
+    if not isinstance(value, dict):
+        return value
+    pool = value.get(POOL_KEY)
+    if pool is None:
+        return value
+    if not isinstance(pool, dict) or pool.get("schema_version") != POOL_SCHEMA:
+        raise ValueError("unsupported day manifest content pool")
+    headers, scopes = pool.get("exactness_headers"), pool.get("feature_scopes")
+    if not isinstance(headers, dict) or not isinstance(scopes, dict):
+        raise ValueError("day manifest content pools are missing")
+    for digest, header in headers.items():
+        if (not isinstance(header, dict) or set(header) != set(HEADER_KEYS)
+                or header.get("schema_version") != EXACTNESS_IDENTITY_SCHEMA_VERSION
+                or identities_sha256(header) != digest):
+            raise ValueError("day manifest exactness schema hash differs")
+    scope_bytes = {}
+    for digest, scope in scopes.items():
+        if not isinstance(scope, dict) or identities_sha256(scope) != digest:
+            raise ValueError("day manifest feature scope hash differs")
+        scope_bytes[digest] = json.dumps(scope, ensure_ascii=False, separators=(",", ":"))
+
+    def restore(node):
+        if isinstance(node, dict):
+            if HEADER_REF in node:
+                digest = node[HEADER_REF]
+                if digest not in headers or any(name in node for name in HEADER_KEYS):
+                    raise ValueError("day manifest exactness schema reference differs")
+                header = headers[digest]
+                return {**{name: item for name, item in node.items() if name != HEADER_REF},
+                    "schema_version": header["schema_version"], "columns": list(header["columns"]),
+                    "dtypes": dict(header["dtypes"])}
+            if SCOPE_REF in node:
+                digest = node[SCOPE_REF]
+                if set(node) != {SCOPE_REF} or digest not in scope_bytes:
+                    raise ValueError("day manifest feature scope reference differs")
+                return json.loads(scope_bytes[digest])
+            return {name: restore(item) for name, item in node.items()}
+        if isinstance(node, list) and node and isinstance(node[0], (dict, list)):
+            return [restore(item) for item in node]
+        return node
+
+    return restore({name: item for name, item in value.items() if name != POOL_KEY})
