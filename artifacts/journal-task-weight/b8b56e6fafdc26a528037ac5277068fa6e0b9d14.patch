+    import algobench.formal_f40_stages as module
+    from algobench.ml.artifacts import atomic_write_json
+    path, source = write_source(tmp_path / "sources")
+    archive = archive_f40_sources(path.parent, tmp_path / "facts.tar", [source])
+    manifest = tmp_path / "manifest.json"
+    atomic_write_json(manifest, {"sources": [source], "archive": archive})
+    def unexpected_sync(fd):
+        raise AssertionError("publication validation must retain its file cache")
+    monkeypatch.setattr(module.os, "fsync", unexpected_sync)
+    # Read-only validation decodes every member without creating a new receipt.
+    module.validate_f40_sources(manifest, read_only=True, release_cache=False)
+    target = tmp_path / "facts.tar"
+    with target.open("r+b") as handle:
+        handle.write(b"changed")
+    with pytest.raises(ValueError, match="archive hash"):
+        module.validate_f40_sources(manifest, read_only=True, release_cache=False)
