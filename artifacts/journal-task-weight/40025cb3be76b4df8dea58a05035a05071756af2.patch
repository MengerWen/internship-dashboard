diff --git a/scripts/tests/test_native_auction_rules.py b/scripts/tests/test_native_auction_rules.py
new file mode 100644
index 00000000..735c8b0c
--- /dev/null
+++ b/scripts/tests/test_native_auction_rules.py
@@ -0,0 +1,46 @@
+"""交易所集合竞价规则的手算反例。"""
+import pytest
+from snapshot.orderbook import OrderBook
+from snapshot.auction import indicative_auction
+
+
+def test_better_price_orders_must_all_fill_before_reference_tiebreak():
+    book = OrderBook()
+    book.apply_order(1,'B',100000,200,'L')
+    book.apply_order(2,'B',90000,500,'L')
+    book.apply_order(3,'S',80000,500,'L')
+    # 8 元虽然成交量也是 500，但高于 8 元的 700 股买单无法全部成交。
+    result = indicative_auction(book, reference_price_i=80000)
+    assert (result.price_i,result.matched_vol,result.imbalance) == (90000,500,200)
+
+
+def test_shanghai_uses_middle_price_of_equal_eligible_quotes():
+    book = OrderBook()
+    book.apply_order(1,'B',100000,100,'L')
+    book.apply_order(2,'S',80000,100,'L')
+    result = indicative_auction(book, reference_price_i=80000, market='XSHG')
+    assert (result.price_i,result.matched_vol,result.imbalance) == (90000,100,0)
+
+
+def test_shanghai_middle_price_rounds_half_up_to_the_stock_tick():
+    book = OrderBook()
+    book.apply_order(1,'B',100100,100,'L')
+    book.apply_order(2,'S',100000,100,'L')
+    assert indicative_auction(book, market='XSHG').price_i == 100100
+
+
+def test_shenzhen_auction_requires_its_reference_if_more_than_one_price_is_eligible():
+    book = OrderBook()
+    book.apply_order(1,'B',100000,100,'L')
+    book.apply_order(2,'S',80000,100,'L')
+    with pytest.raises(ValueError,match='reference'):
+        indicative_auction(book)
+
+
+def test_unpublished_continuous_market_orders_are_not_auction_liquidity():
+    book = OrderBook()
+    book.apply_order(1,'B',100000,100,'L')
+    book.apply_order(2,'S',100000,100,'L')
+    book.apply_order(3,'B',0,1000,'M')
+    result = indicative_auction(book)
+    assert (result.price_i,result.matched_vol,result.imbalance) == (100000,100,0)
