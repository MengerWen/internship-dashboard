+def indicative_auction(book: OrderBook, *, reference_price_i: int = 0,
+                       market: str = 'XSHE', tick_size_i: int = 100) -> IndicativeAuction:
+    """按交易所规则计算已发布限价簿的虚拟撮合，股票价格单位为 1/10000 元。"""
+    if market not in ('XSHE','XSHG') or tick_size_i <= 0:
+        raise ValueError('auction market and positive price tick are required')
+    prices = sorted(set(book.bid_book) | set(book.ask_book))
+    if not prices:
+        return IndicativeAuction(0,0,0)
+    buy = [0, *accumulate(book.bid_book.get(p,0) for p in prices)]
+    sell = [0, *accumulate(book.ask_book.get(p,0) for p in prices)]
+    eligible = []
+    for i,p in enumerate(prices):
+        demand, supply = buy[-1]-buy[i], sell[i+1]
+        matched = min(demand,supply)
+        # 更优价的申报必须全部成交；同价至少一方全部成交由 min 保证。
+        better_buy, better_sell = buy[-1]-buy[i+1], sell[i]
+        if matched > 0 and max(better_buy,better_sell) <= matched:
+            eligible.append(IndicativeAuction(p,matched,demand-supply))
+    if not eligible:
+        return IndicativeAuction(0,0,0)
+    maximum = max(row.matched_vol for row in eligible)
+    eligible = [row for row in eligible if row.matched_vol == maximum]
+    smallest = min(abs(row.imbalance) for row in eligible)
+    eligible = [row for row in eligible if abs(row.imbalance) == smallest]
+    if len(eligible) == 1:
+        return eligible[0]
+    if market == 'XSHE':
+        if reference_price_i <= 0:
+            raise ValueError('ambiguous Shenzhen auction requires a positive reference price')
+        distance = min(abs(row.price_i-reference_price_i) for row in eligible)
+        closest = [row for row in eligible if abs(row.price_i-reference_price_i) == distance]
+        if len(closest) != 1:
+            raise ValueError('auction reference does not uniquely determine price')
+        return closest[0]
+    # 上交所取最小未成交量价位的中间价，再按最小价格单位四舍五入。
+    price = ((eligible[0].price_i+eligible[-1].price_i+tick_size_i)//(2*tick_size_i))*tick_size_i
+    demand = buy[-1]-buy[bisect_left(prices,price)]
+    supply = sell[bisect_right(prices,price)]
+    return IndicativeAuction(price,min(demand,supply),demand-supply)
