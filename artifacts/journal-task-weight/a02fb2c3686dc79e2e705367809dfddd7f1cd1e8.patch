+#!/usr/bin/env python3
+"""比较有界真实 order 页的完整读取调用；保留逐查询证据与重复行。"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict
+from datetime import datetime, timezone
+import gc
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "lv2_snapshot_workspace/src"))
+import numpy as np
+import pandas as pd
+from snapshot import io as gateway
+from snapshot.bounded_page_io import load_bounded_code_range
+from benchmark_doris_page_processing import CLUSTERS, require_compute_window
+
+VARIANTS = (("stable_incremental", 1), ("hash_incremental", 1), ("hash_buffered", 4))
+
+
+def digest_frames(frames):
+    digest = hashlib.sha256()
+    for code, frame in sorted(frames.items()):
+        digest.update(code.encode())
+        digest.update(repr([(c, str(t)) for c, t in frame.dtypes.items()]).encode())
+        hashes = pd.util.hash_pandas_object(frame, index=False).to_numpy()
+        digest.update(np.sort(hashes).tobytes())
+    return digest.hexdigest()
+
+
+def save(path, report):
+    path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    report = {"code_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
+              "started_utc": datetime.now(timezone.utc).isoformat(), "status": "running", "samples": [],
+              "comparison": "outer call wall; independent serial SQL, cache not cleared; raw multiset and dtypes",
+              "date": "2026-06-30", "sql_count_limit": 27}
+    deadline = time.monotonic() + 600
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        for cluster, start in CLUSTERS:
+            codes = tuple(f"{c:06d}" for c in range(start, start + 80))
+            spec = gateway.make_query_spec(
+                "2026-06-30", "order", codes, code_range=(codes[0], codes[-1]),
+                data_time_intervals=(gateway.DataTimeInterval("2026-06-30 09:30:00", "2026-06-30 09:35:00"),),
+            )
+            expected = None
+            for repeat in range(3):
+                for variant, threads in VARIANTS[repeat:] + VARIANTS[:repeat]:
+                    require_compute_window(deadline)
+                    gc.collect()
+                    metrics = gateway.StreamMetrics()
+                    tick, cpu = time.perf_counter(), time.process_time()
+                    if variant == "stable_incremental":
+                        frames = gateway.load_table_code_range(spec, metrics=metrics, arrow_threads=1)
+                    else:
+                        frames = load_bounded_code_range(
+                            spec, metrics=metrics, arrow_threads=threads,
+                            page_parser="buffered" if variant == "hash_buffered" else "incremental",
+                        )
+                    wall, cpu_seconds = time.perf_counter() - tick, time.process_time() - cpu
+                    digest = digest_frames(frames)
+                    if expected is None:
+                        expected = digest
+                    if digest != expected:
+                        raise RuntimeError("SQL replay changed raw rows or column dtypes")
+                    sample = {"cluster": cluster, "repeat": repeat, "variant": variant, "threads": threads,
+                              "wall_seconds": wall, "cpu_seconds": cpu_seconds, "metrics": asdict(metrics),
+                              "raw_multiset_sha256": digest, "code_count": len(frames),
+                              "sql": gateway.build_select_sql(spec)}
+                    report["samples"].append(sample)
+                    save(args.output, report)
+                    print(json.dumps({k: sample[k] for k in ("cluster", "repeat", "variant", "wall_seconds")}), flush=True)
+                    del frames
+        report["status"] = "passed"
+    except BaseException as error:
+        report["status"] = "failed"
+        report["error"] = repr(error)
+        raise
+    finally:
+        report["finished_utc"] = datetime.now(timezone.utc).isoformat()
+        save(args.output, report)
+
+
+if __name__ == "__main__":
+    main()
