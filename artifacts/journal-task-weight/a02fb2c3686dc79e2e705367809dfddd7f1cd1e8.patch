+"""单查询、有界页读取；原始行只在公司服务器内存中处理。"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import replace
+import io
+import os
+from pathlib import Path
+import subprocess
+import threading
+import time
+
+import pandas as pd
+
+from . import io as gateway
+from .page_processing import group_code_page, process_code_range_payload
+
+_SQL_LOCK = threading.Lock()
+MAX_PAGE_BYTES = 64 << 20
+MAX_PAGE_ROWS = 1_000_000
+QUERY_TIMEOUT_SECONDS = 120.0
+
+
+class PageBudgetExceeded(gateway.DorisQueryError):
+    """当前 SQL 页需拆成互不重叠的更小股票范围。"""
+
+
+@contextmanager
+def query_slot():
+    """Linux 同账户进程共享 SQL 锁；本地测试只需线程锁。"""
+    with _SQL_LOCK:
+        if os.name != "posix":
+            yield
+            return
+        import fcntl
+
+        path = Path("/tmp") / f"sirui-doris-sql-{os.getuid()}.lock"
+        with path.open("a+b") as stream:
+            fcntl.flock(stream, fcntl.LOCK_EX)
+            try:
+                yield
+            finally:
+                fcntl.flock(stream, fcntl.LOCK_UN)
+
+
+class _BudgetRaw(gateway._CountingRaw):
+    def __init__(self, raw, *, started, max_bytes, max_rows):
+        super().__init__(raw, started=started)
+        self.max_bytes, self.max_rows = max_bytes, max_rows
+        self.lines = 0
+        self.last_byte = b""
+
+    def readinto(self, buffer):
+        # Limit over-read when the Arrow reader requests an entire parser block.
+        view = memoryview(buffer)[:min(len(buffer), 1 << 20, self.max_bytes - self.bytes_read + 1)]
+        count = super().readinto(view)
+        if count:
+            data = bytes(view[:count])
+            self.lines += data.count(b"\n")
+            self.last_byte = data[-1:]
+        rows = self.lines + int(bool(self.bytes_read) and self.last_byte != b"\n")
+        if self.bytes_read > self.max_bytes or rows > self.max_rows:
+            raise PageBudgetExceeded("Doris page exceeded row or byte budget")
+        return count
+
+
+def _read_one(
+    spec, *, backend, login_path, database, popen_factory, arrow_threads,
+    parser_block_size, metrics, peak_rss_reader, page_parser, max_bytes, max_rows,
+    query_timeout_seconds,
+):
+    query_started = time.perf_counter()
+    parts, data = [], b""
+    with query_slot():
+        gateway.wait_for_doris_window()
+        started = time.perf_counter()
+        process = popen_factory(
+            gateway._mysql_command(login_path=login_path, database=database),
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0,
+        )
+        if any(pipe is None for pipe in (process.stdin, process.stdout, process.stderr)):
+            gateway._terminate_process(process)
+            raise gateway.DorisQueryError("mysql subprocess did not expose all required pipes")
+        stderr = gateway._StderrDrain(process.stderr)
+        stderr.start()
+        raw = _BudgetRaw(process.stdout, started=started, max_bytes=max_bytes, max_rows=max_rows)
+        expired = threading.Event()
+
+        def abort():
+            expired.set()
+            if gateway._process_running(process):
+                process.kill()
+
+        timer = threading.Timer(query_timeout_seconds, abort)
+        timer.daemon = True
+        timer.start()
+        completed = False
+        try:
+            process.stdin.write((gateway.build_select_sql(spec) + "\n").encode("utf-8"))
+            process.stdin.close()
+            if page_parser == "buffered" and backend == "pyarrow":
+                data = io.BufferedReader(raw, buffer_size=1 << 20).read()
+            else:
+                frames = (
+                    gateway._iter_pyarrow_frames(raw, spec.columns, arrow_threads=arrow_threads,
+                                                block_size=parser_block_size)
+                    if backend == "pyarrow" else gateway._iter_pandas_frames(raw, spec.columns)
+                )
+                parts = [frame for frame in frames if not frame.empty]
+            completed = True
+        finally:
+            timer.cancel()
+            if not completed and gateway._process_running(process):
+                gateway._terminate_process(process)
+            process.stdout.close()
+            returncode = gateway._wait_process(process)
+            stderr.join()
+            metrics.query_count += 1
+            metrics.bytes_read += raw.bytes_read
+            metrics.read_rows += raw.lines + int(bool(raw.bytes_read) and raw.last_byte != b"\n")
+            if metrics.query_count == 1:
+                metrics.first_row_seconds = raw.first_byte_seconds
+            metrics.drain_seconds += time.perf_counter() - started
+            if expired.is_set():
+                raise gateway.DorisQueryError("Doris page exceeded query time budget")
+            if completed and returncode:
+                raise gateway.DorisQueryError(gateway._safe_diagnostic(stderr.text()))
+    if page_parser == "buffered" and backend == "pyarrow":
+        result = process_code_range_payload(
+            data, spec, parser="buffered", threads=int(arrow_threads or 1),
+            max_bytes=max_bytes, max_rows=max_rows, block_size=parser_block_size,
+        )
+        metrics.parse_seconds += result.parse_seconds
+        metrics.grouping_seconds += result.grouping_seconds
+        frames, retained = result.frames, result.retained_rows
+    elif parts:
+        page = parts[0] if len(parts) == 1 else pd.concat(parts, ignore_index=True)
+        grouping_started = time.perf_counter()
+        frames, retained = group_code_page(page, spec.codes)
+        metrics.grouping_seconds += time.perf_counter() - grouping_started
+    else:
+        frames, retained = {}, 0
+    metrics.retained_rows += retained
+    metrics.rows = metrics.retained_rows
+    metrics.discarded_rows = metrics.read_rows - metrics.retained_rows
+    metrics.elapsed_seconds += time.perf_counter() - query_started
+    metrics.peak_rss_bytes = max(metrics.peak_rss_bytes, int(peak_rss_reader()))
+    return frames
+
+
+def load_bounded_code_range(
+    spec, *, backend="pyarrow", login_path=gateway.DB_LOGIN_PATH, database=gateway.DB_NAME,
+    popen_factory=subprocess.Popen, arrow_threads=None, parser_block_size=4 << 20,
+    metrics=None, peak_rss_reader=None, page_parser="incremental",
+    max_bytes=MAX_PAGE_BYTES, max_rows=MAX_PAGE_ROWS, query_timeout_seconds=QUERY_TIMEOUT_SECONDS,
+):
+    """超预算时丢弃该次页，按股票池二分；单股超预算需配置更短时间窗。"""
+    if spec.code_range is None or spec.codes is None or "code" not in spec.columns:
+        raise ValueError("bounded reader requires a code-range spec with explicit codes")
+    if backend not in {"pyarrow", "pandas"} or page_parser not in {"incremental", "buffered"}:
+        raise ValueError("unsupported parser backend or page parser")
+    if arrow_threads is not None and (isinstance(arrow_threads, bool) or not isinstance(arrow_threads, int)
+                                     or not 1 <= arrow_threads <= 16):
+        raise ValueError("arrow_threads must be an integer within 1..16")
+    if min(max_bytes, max_rows, parser_block_size, query_timeout_seconds) <= 0:
+        raise ValueError("page budgets must be positive")
+    current = metrics if metrics is not None else gateway.StreamMetrics()
+    for name in vars(gateway.StreamMetrics()):
+        setattr(current, name, 0)
+    kwargs = dict(backend=backend, login_path=login_path, database=database,
+                  popen_factory=popen_factory, arrow_threads=arrow_threads,
+                  parser_block_size=parser_block_size, metrics=current,
+                  peak_rss_reader=peak_rss_reader or gateway.process_peak_rss_bytes,
+                  page_parser=page_parser, max_bytes=max_bytes, max_rows=max_rows,
+                  query_timeout_seconds=query_timeout_seconds)
+    started = time.perf_counter()
+
+    def load(page):
+        try:
+            return _read_one(page, **kwargs)
+        except PageBudgetExceeded:
+            if len(page.codes) == 1:
+                raise PageBudgetExceeded(
+                    f"single-stock page {page.codes[0]} exceeds budget; use shorter explicit data_time intervals"
+                ) from None
+            codes = tuple(sorted(page.codes))
+            midpoint = len(codes) // 2
+            frames = {}
+            for subset in (codes[:midpoint], codes[midpoint:]):
+                child = replace(page, codes=subset, code_range=(subset[0], subset[-1]))
+                frames.update(load(child))
+            return frames
+
+    try:
+        return load(spec)
+    finally:
+        current.elapsed_seconds = time.perf_counter() - started
+        current.discarded_rows = current.read_rows - current.retained_rows
+        current.peak_rss_bytes = max(current.peak_rss_bytes, int(kwargs["peak_rss_reader"]()))
