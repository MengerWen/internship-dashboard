+from __future__ import annotations
+
+from dataclasses import replace
+import io
+import re
+import threading
+import time
+
+import pandas as pd
+import pytest
+
+from snapshot import io as gateway
+from snapshot.bounded_page_io import PageBudgetExceeded, load_bounded_code_range, query_slot
+
+
+DATA = b"2\t1\t000002\t20\n1\t1\t000001\t10\n3\t1\t000002\t30\n4\t1\t000001\t40\n"
+
+
+def spec():
+    return gateway.make_query_spec(
+        "2026-06-30", "order", ("000001", "000002"),
+        columns=("seq", "channel_no", "code", "qty"), code_range=("000001", "000002"),
+    )
+
+
+class Process:
+    def __init__(self, data=DATA):
+        self.stdin, self.stdout, self.stderr = io.BytesIO(), io.BytesIO(data), io.BytesIO()
+
+    def poll(self):
+        return 0
+
+    def wait(self):
+        return 0
+
+
+@pytest.mark.parametrize("parser", ["incremental", "buffered"])
+def test_bounded_reader_preserves_values_types_and_stock_row_order(parser):
+    expected = gateway.load_table_code_range(spec(), popen_factory=lambda *a, **k: Process())
+    metrics = gateway.StreamMetrics()
+    actual = load_bounded_code_range(
+        spec(), popen_factory=lambda *a, **k: Process(), page_parser=parser,
+        metrics=metrics, peak_rss_reader=lambda: 100,
+    )
+    for code in expected:
+        pd.testing.assert_frame_equal(actual[code], expected[code], check_exact=True)
+    assert metrics.query_count == 1 and metrics.retained_rows == metrics.read_rows == 4
+    assert metrics.bytes_read == len(DATA) and metrics.peak_rss_bytes == 100
+    assert metrics.elapsed_seconds >= metrics.drain_seconds + metrics.grouping_seconds
+
+
+@pytest.mark.parametrize("parser", ["incremental", "buffered"])
+def test_page_budget_splits_disjoint_codes_and_never_returns_partial_data(parser):
+    class Input(io.BytesIO):
+        def close(self):
+            sql = self.getvalue().decode()
+            lo, hi = re.findall(r"code (?:>=|<=) '([0-9]{6})'", sql)
+            owner.stdout = io.BytesIO(b"".join(
+                line + b"\n" for line in DATA.splitlines() if lo <= line.split(b"\t")[2].decode() <= hi
+            ))
+            # The reader already holds the pipe; replace its contents in place.
+            output.seek(0); output.truncate(); output.write(owner.stdout.getvalue()); output.seek(0)
+            owner.stdout = output
+
+    def factory(*args, **kwargs):
+        nonlocal owner, output
+        owner = Process(b"")
+        output = owner.stdout
+        owner.stdin = Input()
+        return owner
+
+    owner, output = None, None
+    metrics = gateway.StreamMetrics()
+    actual = load_bounded_code_range(spec(), popen_factory=factory, max_rows=3,
+                                     page_parser=parser, metrics=metrics)
+    assert list(actual) == ["000001", "000002"]
+    assert list(actual["000001"].seq) == [1, 4]
+    assert list(actual["000002"].seq) == [2, 3]
+    assert metrics.query_count == 3 and metrics.retained_rows == 4
+    assert metrics.read_rows == 8 and metrics.discarded_rows == 4
+
+
+def test_single_stock_budget_requires_an_explicit_shorter_window():
+    one = replace(spec(), codes=("000001",), code_range=("000001", "000001"))
+    with pytest.raises(PageBudgetExceeded, match="shorter explicit data_time"):
+        load_bounded_code_range(one, popen_factory=lambda *a, **k: Process(), max_bytes=10)
+
+
+def test_sql_slot_serializes_query_threads():
+    active = maximum = 0
+
+    def task():
+        nonlocal active, maximum
+        with query_slot():
+            active += 1
+            maximum = max(maximum, active)
+            time.sleep(0.01)
+            active -= 1
+
+    threads = [threading.Thread(target=task) for _ in range(3)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    assert maximum == 1
+
+
+def test_query_timeout_reaps_mysql_and_reports_time_budget():
+    released = threading.Event()
+
+    class Slow(io.BytesIO):
+        def readinto(self, buffer):
+            released.wait(timeout=1)
+            return 0
+
+    class Blocked(Process):
+        def __init__(self):
+            super().__init__(b"")
+            self.stdout = Slow()
+            self.killed = False
+
+        def poll(self):
+            return 0 if self.killed else None
+
+        def kill(self):
+            self.killed = True
+            released.set()
+
+    process = Blocked()
+    with pytest.raises(gateway.DorisQueryError, match="time budget"):
+        load_bounded_code_range(spec(), popen_factory=lambda *a, **k: process,
+                                 query_timeout_seconds=0.02, page_parser="buffered")
+    assert process.killed
