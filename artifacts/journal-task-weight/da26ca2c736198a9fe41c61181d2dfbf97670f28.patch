+def test_binding_regression_keeps_full_calendar_and_requires_its_explicit_day():
+    from algobench.formal_raw_bank_startup import frozen_formal_calendar
+    day = "2026-04-22"
+    runtime = dict(binding_regression_only=True, kernel_calibration=dict(dates=[day]))
+    calendar = frozen_formal_calendar(runtime, day)
+    assert len(calendar) == 601 and day in calendar
+    assert (calendar[0], calendar[-1]) == ("2024-01-02", "2026-06-30")
+    for selected in (None, "2026-01-13"):
+        with pytest.raises(ValueError, match="single explicit date"):
+            frozen_formal_calendar(runtime, selected)
+    with pytest.raises(ValueError, match="601 dates"):
+        frozen_formal_calendar(dict(kernel_calibration=dict(dates=[day])), day)
+    assert frozen_formal_calendar(dict(kernel_calibration=dict(dates=calendar)), None) == calendar
+
