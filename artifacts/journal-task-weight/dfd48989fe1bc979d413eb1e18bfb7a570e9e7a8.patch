+def same_values(left, right):
+    import pyarrow as pa
+    if not left.schema.equals(right.schema, check_metadata=False) or len(left) != len(right):
+        return False
+    changed = [field.name for field in left.schema if pa.types.is_floating(field.type)
+        or not left[field.name].equals(right[field.name])]
+    if not changed:
+        return True
+    if any(not left[name].is_null().equals(right[name].is_null()) for name in changed):
+        return False
+    # Arrow equals 将同位置 NaN 判为不同；沿用科学合同的完整数值与空值身份。
+    def identity(table):
+        return table_exactness_identities(table.select(changed), {"all": tuple(changed)},
+            arrow_int64_lists=True, arrow_strings=True)[1]
+    return identity(left) == identity(right)
+
