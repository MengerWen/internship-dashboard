+import importlib.util
+from pathlib import Path
+
+import numpy as np
+import pyarrow as pa
+import pytest
+
+
+def load_module():
+    path = Path(__file__).resolve().parents[1] / "benchmark_formal_day_bucket_publication.py"
+    spec = importlib.util.spec_from_file_location("publication_probe", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize("change", [None, "value", "null", "nan_position", "integer", "zero_sign"])
+def test_fixture_comparison_preserves_nan_null_and_exact_integer_identity(change):
+    module = load_module()
+    left = pa.table(dict(value=pa.array([np.nan, None, 0., -0., .5]),
+        integer=pa.array([2**62+1] * 5, type=pa.int64()), text=["甲", None, "x", "x", "y"],
+        finite=[0., .1, .2, .3, .4]))
+    values = [np.nan, None, 0., -0., .5]
+    integers = [2**62+1] * 5
+    finite = [0., .1, .2, .3, .4]
+    if change == "value": values[-1] = np.nextafter(.5, 1.)
+    if change == "null": values[1] = np.nan
+    if change == "nan_position": values[0], values[2] = values[2], values[0]
+    if change == "integer": integers[-1] += 1
+    if change == "zero_sign": finite[0] = -0.
+    right = pa.table(dict(value=pa.array(values), integer=pa.array(integers, type=pa.int64()),
+        text=["甲", None, "x", "x", "y"], finite=finite))
+    assert module.same_values(left, right) is (change is None)
