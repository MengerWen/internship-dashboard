@@ -38,2 +40,41 @@ def _universe(dates: tuple[str, ...], count: int = 5) -> pd.DataFrame:
 
+def test_pilot_hands_audited_selection_and_resources_to_formal_runner(tmp_path, monkeypatch):
+    module = _load_module()
+    cfg = SimpleNamespace(output_root=tmp_path)
+    engine, label_consumer = object(), object()
+    captured = []
+    monkeypatch.setattr(module, "load_config", lambda _path: cfg)
+    monkeypatch.setattr(module, "expected_attention_dates", lambda *a, **k: ["2026-06-30"])
+    monkeypatch.setattr(module, "load_attention_universe", lambda _cfg, dates: _universe(dates))
+    monkeypatch.setattr(module.FormalFactorEngine, "from_defaults", lambda **k: engine)
+    monkeypatch.setattr(module, "load_formal_label_config", lambda **k: SimpleNamespace(
+        vwap_source="rqdata", audit_sample_size=10, audit_min_coverage=1.0))
+    monkeypatch.setattr(module, "load_rqdata_price_batch", lambda _cfg: SimpleNamespace(frame=pd.DataFrame()))
+    monkeypatch.setattr(module, "audit_rqdata_vwap_units", lambda *a, **k: {"passed": True})
+    monkeypatch.setattr(module, "FormalLabelPriceConsumer", lambda: label_consumer)
+
+    class RunnerReceived(RuntimeError):
+        pass
+
+    def run(spec):
+        captured.append(spec)
+        raise RunnerReceived()
+
+    monkeypatch.setattr(module, "run_panel", run)
+    with pytest.raises(RunnerReceived):
+        module.run_pilot(workers=3, compute_workers=5, parser_threads_per_stream=4,
+                         execute_notebook=False, kernel_name="python3", run_kind="smoke",
+                         years=(2026,), days_per_year=1, stocks=2)
+    spec, = captured
+    assert spec.cfg is cfg and spec.engine is engine
+    assert spec.scope.dates == ("2026-06-30",)
+    assert spec.scope.codes == ("000001", "000005")
+    assert (spec.resources.workers, spec.resources.compute_workers,
+            spec.resources.parser_threads_per_stream) == (3, 5, 4)
+    assert spec.execution.emit_stock_day_progress is True
+    assert spec.extra_consumers == ((module.LABEL_CONSUMER_NAME, label_consumer),)
+    assert spec.output_root == module.pilot_output_roots(tmp_path, "smoke")[1]
+    assert spec.resume is False
+
+
