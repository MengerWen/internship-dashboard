+@pytest.mark.parametrize("listing_code,listing_output,missing", [
+    (0, b"", True), (1, b"", False), (0, b'{"status":"success"}', False),
+])
+def test_optional_object_read_uses_exact_key_absence_evidence(tmp_path, monkeypatch,
+                                                            listing_code, listing_output, missing):
+    calls = []
+    def run(argv, **kwargs):
+        calls.append(argv[1])
+        if argv[1] == "cat": return subprocess.CompletedProcess(argv, 1, b"")
+        if argv[1] == "stat":
+            return subprocess.CompletedProcess(argv, 1, b'{"status":"error","error":{"cause":{"error":{}}}}')
+        assert argv == ["mc", "ls", "--json", "company/bucket/missing.json"]
+        return subprocess.CompletedProcess(argv, listing_code, listing_output)
+    monkeypatch.setattr(subprocess, "run", run)
+    publisher = ObjectPublication(str(tmp_path), "company/bucket")
+    if missing:
+        assert publisher.read_json(tmp_path / "missing.json", optional=True) is None
+    else:
+        with pytest.raises(RuntimeError, match="readback failed"):
+            publisher.read_json(tmp_path / "missing.json", optional=True)
+    assert calls == ["cat", "stat", "ls"]
