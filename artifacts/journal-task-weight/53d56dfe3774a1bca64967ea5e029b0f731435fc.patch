@@ -260,2 +260,39 @@ def test_publication_cache_retains_bytes_without_accepting_changed_archive(tmp_p
 
+@pytest.mark.parametrize("damage", ["none", "part", "order", "missing", "path"])
+def test_segmented_archive_preserves_complete_facts_and_rejects_bad_parts(tmp_path, damage):
+    import algobench.formal_f40_stages as module
+    path, source = write_source(tmp_path / "sources")
+    expected = path.read_bytes()
+    archive = archive_f40_sources(path.parent, tmp_path / "facts.tar", [source])
+    original = (tmp_path / "facts.tar").read_bytes()
+    parts = []
+    for index, offset in enumerate(range(0, len(original), 4097)):
+        data = original[offset:offset+4097]
+        target = tmp_path / f"part-{index}"
+        target.write_bytes(data)
+        parts.append({"file": target.name, "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()})
+    (tmp_path / "facts.tar").unlink()
+    if damage == "part":
+        with (tmp_path / parts[0]["file"]).open("r+b") as handle:
+            handle.write(b"broken")
+    elif damage == "order":
+        parts.reverse()
+    elif damage == "missing":
+        parts.pop()
+    elif damage == "path":
+        parts[0]["file"] = "../part-0"
+    manifest_path = tmp_path / "manifest.json"
+    manifest = {"sources": [source], "archive": {**archive, "parts": parts}}
+    manifest_path.write_text(json.dumps(manifest))
+    if damage != "none":
+        with pytest.raises(ValueError, match="archive"):
+            module.validate_f40_sources(manifest_path)
+        return
+    module.validate_f40_sources(manifest_path)
+    with module.f40_archive_reader(manifest_path, manifest["archive"]) as handle:
+        assert handle.read() == original
+    with local_f40_sources(manifest_path, manifest) as extracted:
+        assert (extracted / source["file"]).read_bytes() == expected
+
+
