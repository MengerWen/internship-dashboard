+def f40_archive_paths(manifest_path: Path, archive):
+    parts = archive.get("parts")
+    rows = parts if parts is not None else [archive]
+    if not rows or sum(row["bytes"] for row in rows) != archive["bytes"]:
+        raise ValueError("F40 archive part size inventory mismatch")
+    names = [row["file"] for row in rows]
+    if len(names) != len(set(names)) or any(Path(name).name != name for name in names):
+        raise ValueError("F40 archive parts must have unique basenames")
+    return [(manifest_path.parent / row["file"], row) for row in rows]
+
+
+class _ArchivePartsReader(io.RawIOBase):
+    def __init__(self, paths, *, release_cache):
+        super().__init__()
+        self.paths = iter(paths)
+        self.release_cache = release_cache
+        self.current = self.context = None
+
+    def readable(self):
+        return True
+
+    def readinto(self, target):
+        while True:
+            if self.current is None:
+                path = next(self.paths, None)
+                if path is None:
+                    return 0
+                self.context = _archive_reader(path, release_cache=self.release_cache)
+                self.current = self.context.__enter__()
+            size = self.current.readinto(target)
+            if size:
+                return size
+            self.context.__exit__(None, None, None)
+            self.current = self.context = None
+
+    def close(self):
+        try:
+            if self.context is not None:
+                self.context.__exit__(None, None, None)
+                self.current = self.context = None
+        finally:
+            super().close()
+
+
+@contextmanager
+def f40_archive_reader(manifest_path: Path, archive, *, release_cache=True):
+    paths = [path for path, _ in f40_archive_paths(manifest_path, archive)]
+    with io.BufferedReader(_ArchivePartsReader(paths, release_cache=release_cache)) as handle:
+        yield handle
+
+
+def verify_f40_archive(manifest_path: Path, archive, *, release_cache=True):
+    complete = hashlib.sha256()
+    for path, row in f40_archive_paths(manifest_path, archive):
+        if path.stat().st_size != row["bytes"]:
+            raise ValueError("F40 source archive hash mismatch")
+        digest = hashlib.sha256()
+        with _archive_reader(path, release_cache=release_cache) as handle:
+            for block in iter(lambda: handle.read(1024**2), b""):
+                digest.update(block)
+                complete.update(block)
+        if digest.hexdigest() != row["sha256"]:
+            raise ValueError("F40 source archive hash mismatch")
+    if complete.hexdigest() != archive["sha256"]:
+        raise ValueError("F40 source archive hash mismatch")
+
