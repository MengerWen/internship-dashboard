+def test_sentinel_clock_includes_child_exit_and_preserves_raw_freeze_time(tmp_path, monkeypatch):
+    start, ready, release, exit_file, timing = [tmp_path / name for name in ("start", "ready", "release", "exit", "timing")]
+    start.touch()
+    release.touch()
+    active = iter([1., 2., 302., 302.])
+    raw = iter([10., 610.])
+    epochs = iter([1000., 1600.])
+    monkeypatch.setattr(sentinel, "active_monotonic", lambda: next(active))
+    monkeypatch.setattr(sentinel.time, "monotonic", lambda: next(raw))
+    monkeypatch.setattr(sentinel.time, "time", lambda: next(epochs))
+    monkeypatch.setattr(sentinel.subprocess, "run", lambda *a, **kw: SimpleNamespace(returncode=0))
+    assert sentinel.main(["--start-file", str(start), "--ready-file", str(ready), "--release-file", str(release),
+        "--exit-code-file", str(exit_file), "--command-timing-file", str(timing), "--", "business"]) == 0
+    record = json.loads(timing.read_text())
+    assert record["active_wall_seconds"] == 300.
+    assert record["raw_wall_seconds"] == 600.
+    assert record["exit_code"] == 0 and record["command"] == ["business"]
