             hashes = hashes.astype("<u8", copy=False)
@@ -216,2 +220,24 @@ def _hashable_series(series: pd.Series) -> pd.Series:
 
+def _int64_array_column_hashes(series):
+    if not len(series) or not isinstance(series.iloc[0], np.ndarray):
+        return None
+    from .formal_numeric_cell_hash import int64_ragged_array_hashes, prepare_numeric_cell_hash_kernel
+    if not prepare_numeric_cell_hash_kernel():
+        return None
+    arrays = series.to_numpy(dtype=object, copy=False)
+    lengths = np.empty(len(arrays), dtype=np.int64)
+    total = 0
+    for position, value in enumerate(arrays):
+        if (not isinstance(value, np.ndarray) or value.ndim != 1 or value.dtype != np.dtype("int64")
+                or value.size > 262144):
+            return None
+        total += value.nbytes
+        if total > _OBJECT_ARRAY_HASH_BYTES:
+            return None
+        lengths[position] = value.size
+    offsets = np.r_[np.int64(0), np.cumsum(lengths)]
+    values = np.concatenate(arrays)
+    return int64_ragged_array_hashes(values, offsets, np.arange(len(arrays), dtype=np.int64))
+
