+def test_persisted_integer_array_columns_keep_v1_identity_across_blocks(monkeypatch):
+    import algobench.formal_exactness as exact
+    rng = np.random.default_rng(92781)
+    values = [np.empty(0, dtype=np.int64), np.array([-(2**63), 2**63-1, 2**53+1], dtype=np.int64),
+              rng.integers(-(2**63), 2**63-1, 10000, dtype=np.int64),
+              np.arange(34, dtype=np.int64)[::2]]
+    frame = pd.DataFrame({"triggers": pd.Series(values + [values[i % 2] for i in range(32795)], dtype=object),
+                          "score": np.linspace(0., 1., 32799)})
+    before = [value.copy() for value in values]
+    projections = {"all": tuple(frame.columns), "array": ("triggers",)}
+    positions = {"array": np.arange(0, len(frame), 3)}
+    observed = exact.frame_exactness_identities(frame, projections, row_positions=positions)
+    with monkeypatch.context() as patch:
+        patch.setattr(exact, "_int64_array_column_hashes", lambda series: None)
+        expected = exact.frame_exactness_identities(frame, projections, row_positions=positions)
+    assert observed == expected
+    for value, original in zip(values, before):
+        np.testing.assert_array_equal(value, original)
+
+
+@pytest.mark.parametrize("other", [None, [1, 2], np.array([1, 2], dtype=np.int32),
+                                  np.array([1, 2], dtype=">i8"), np.array([[1, 2]], dtype=np.int64)])
+def test_integer_array_hashes_preserve_mixed_type_fallback(monkeypatch, other):
+    import algobench.formal_exactness as exact
+    frame = pd.DataFrame({"triggers": pd.Series([np.array([1, 2], dtype=np.int64), other], dtype=object)})
+    observed = exact.frame_exactness_identity(frame)
+    with monkeypatch.context() as patch:
+        patch.setattr(exact, "_int64_array_column_hashes", lambda series: None)
+        expected = exact.frame_exactness_identity(frame)
+    assert observed == expected
+
