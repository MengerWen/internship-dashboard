+@pytest.mark.parametrize('mode', ['single', 'windows'])
+def test_completed_run_releases_phase_state_before_cyclic_gc(tmp_path, monkeypatch, mode):
+    import gc
+    import weakref
+    from algobench.formal import panel
+    cls = panel._PanelExecution if mode == 'single' else panel._WindowExecution
+    instances = []
+    original = cls.run
+    def observe(execution):
+        instances.append(weakref.ref(execution))
+        return original(execution)
+    monkeypatch.setattr(cls, 'run', observe)
+    enabled = gc.isenabled()
+    gc.disable()
+    try:
+        if mode == 'single':
+            result = _run(tmp_path, resume=False)
+            assert result.processed_dates
+        else:
+            result, _ = _run_multiwindow(tmp_path, monkeypatch)
+            assert result.complete_manifest_path.is_file()
+        assert instances and all(reference() is None for reference in instances)
+    finally:
+        if enabled:
+            gc.enable()
