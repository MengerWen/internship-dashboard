-def resolve_day_manifest(record: Mapping[str, object], *, object_publication=None, staging_root=None,
-                         share_feature_scopes=False) -> Mapping[str, object]:
-    """Read a committed day manifest and verify its bound content identity."""
-    if "manifest_reference" not in record:
-        return record
-    reference = record["manifest_reference"]
-    path = Path(reference["path"])
-    from ..formal_accepted_detail_retention import record as summary_record, matches_identity, summary_payload
-    payload = summary_payload(path)
-    if payload is not None:
-        pass
-    elif object_publication is None:
-        payload = path.read_bytes()
-    else:
-        from tempfile import TemporaryDirectory
-        if staging_root is None:
-            raise ValueError("object day manifest requires owned local readback staging")
-        Path(staging_root).mkdir(parents=True, exist_ok=True)
-        with TemporaryDirectory(prefix="day-manifest-readback-", dir=staging_root) as temporary:
-            local = Path(temporary) / path.name
-            expected = reference["sha256"]
-            if summary_record(path):
-                expected = object_publication.readback_sha256(path)
-                if not matches_identity(path, reference["sha256"], expected):
-                    raise ValueError("committed day summary differs from its accepted identity")
-            object_publication.stage_verified(path, local, expected_sha256=expected,
-                                              maximum_bytes=512 * 1024**2)
-            payload = local.read_bytes()
-    if not matches_identity(path, reference["sha256"], hashlib.sha256(payload).hexdigest()):
-        raise ValueError("committed day manifest hash differs from its reference")
-    if reference.get("compression") == "gzip":
-        payload = gzip.decompress(payload)
-    elif reference.get("compression") is not None:
-        raise ValueError("unsupported day manifest compression")
-    from ..formal_day_manifest_codec import restore_day_manifest
-    manifest = restore_day_manifest(json.loads(payload), in_place=True, share_feature_scopes=share_feature_scopes)
-    if manifest["date"] != record["date"]:
-        raise ValueError("committed day manifest date differs from its reference")
-    return manifest
