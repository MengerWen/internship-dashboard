+def _universe_identity(frame: pd.DataFrame) -> dict[str, object]:
+    columns = [
+        column
+        for column in (
+            "date",
+            "code",
+            "exchange",
+            "security_type",
+            "board_type",
+            "listed_date",
+            "de_listed_date",
+            "is_st",
+            "is_new_listing_60d",
+        )
+        if column in frame.columns
+    ]
+    stable = frame.loc[:, columns].copy().sort_values(["date", "code"])
+    # Convert extension dtypes before filling missing values.  In particular,
+    # pandas' nullable BooleanDtype correctly rejects the string sentinel "".
+    # The string representation keeps the hash independent of dataframe dtype
+    # while preserving unknown PIT status as an explicit empty field.
+    stable_text = stable.astype("string").fillna("")
+    encoded = stable_text.to_csv(index=False).encode("utf-8")
+    return {
+        "version": UNIVERSE_VERSION,
+        "fingerprint": hashlib.sha256(encoded).hexdigest(),
+        "code_count": int(frame["code"].nunique()),
+        "source": (
+            "accepted company Doris L1 instruments + daily ST status; "
+            "no L2 availability prerequisite"
+        ),
+    }
