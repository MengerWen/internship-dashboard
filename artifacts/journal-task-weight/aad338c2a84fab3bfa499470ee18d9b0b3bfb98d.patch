+def _validate_l2_query_audit(
+    *,
+    day: str,
+    query_records: Sequence[object],
+    expected_codes: Sequence[str],
+    available_codes: Sequence[str],
+    no_evidence_codes: Sequence[str],
+    table_rows: Mapping[str, int],
+    table_codes: Mapping[str, set[str]],
+    query_data_time_upper_bound: str | None = None,
+    query_data_time_intervals_by_table: Mapping[
+        str, Sequence[object]
+    ] | None = None,
+) -> dict[str, object]:
+    """Prove one successful whole-day read per L2 table before any success write."""
+
+    expected = list(expected_codes)
+    available = list(available_codes)
+    no_evidence = list(no_evidence_codes)
+    if (
+        sorted(available + no_evidence) != expected
+        or set(available).intersection(no_evidence)
+    ):
+        raise ValueError(f"incomplete formal L2 code accounting for {day}")
+
+    records_by_table: dict[str, list[object]] = {
+        table: [] for table in L2_TABLES
+    }
+    for record in query_records:
+        if str(getattr(record, "date", "")) != day:
+            raise ValueError(f"L2 query telemetry date mismatch for {day}")
+        table = str(getattr(record, "table", ""))
+        if table not in records_by_table:
+            raise ValueError(f"unexpected L2 query telemetry table for {day}: {table}")
+        records_by_table[table].append(record)
+
+    queries_per_table = {
+        table: sum(int(getattr(record, "query_count", 1)) for record in records_by_table[table])
+        for table in L2_TABLES
+    }
+    if any(len(records_by_table[table]) != 1 for table in L2_TABLES):
+        raise ValueError(
+            f"formal L2 requires one aggregate query receipt per table for {day}: "
+            f"{queries_per_table}"
+        )
+
+    complete_table_rows = {
+        table: int(table_rows.get(table, 0)) for table in L2_TABLES
+    }
+    for table, records in records_by_table.items():
