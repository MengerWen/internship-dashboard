+def test_day_finalizer_reads_live_payloads_before_scheduler_release(tmp_path, monkeypatch):
+    original = _MultiWindowScheduler.run
+    observed = []
+    def release_after_day(self, plans, *, manifest_path=None, on_day_complete=None):
+        run = original(self, plans, manifest_path=manifest_path, on_day_complete=on_day_complete)
+        for task in run.tasks:
+            task.payload = None
+        return run
+    monkeypatch.setattr(_MultiWindowScheduler, "run", release_after_day)
+    def finalize(date_record, tasks, settings):
+        assert date_record.date == DAY1 and all(task.payload is not None for task in tasks)
+        assert formal_panel_shard_path(tmp_path, DAY1, window_token="win_0930_1030").is_file()
+        observed.append(tuple(task.consumer for task in tasks))
+    result, _ = _run_multiwindow(tmp_path, monkeypatch, day_finalizer=finalize)
