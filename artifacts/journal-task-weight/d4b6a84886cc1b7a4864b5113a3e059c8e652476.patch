--- a/因子/algobench/tests/test_f40_streaming_matching.py
+++ b/因子/algobench/tests/test_f40_streaming_matching.py
@@ -25,2 +25,14 @@ def graph_case(n=300, seed=1, tied=False):
 
+@pytest.mark.parametrize("dense", [False, True])
+def test_component_solver_preserves_local_node_order_with_shared_columns(dense):
+    from scipy import sparse
+    from algobench import formal_f40_streaming as streaming
+    local = sparse.csr_matrix(np.array([[.8, .8, 0.], [0., .9, .7], [.6, 0., .95]]))
+    shared = sparse.csr_matrix((local.data, local.indices + 4, local.indptr), shape=(3, 9))
+    expected = streaming._solve_component(local, .1, dense)
+    actual = streaming._solve_component(shared, .1, dense, 4, 3)
+    for a, b in zip(actual, expected, strict=True):
+        np.testing.assert_array_equal(a, b)
+
+
