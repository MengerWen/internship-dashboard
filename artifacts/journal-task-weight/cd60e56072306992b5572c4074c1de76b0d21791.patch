+def classify_price_reach(
+    *,
+    side: object,
+    ord_type: object,
+    submit_price_tick: object,
+    opponent_best_price_tick: object,
+    opponent_second_price_tick: object,
+) -> str:
+    """Classify how far one SZSE order could reach at submission."""
+
+    normalized_side = str(side).strip().upper()
+    normalized_type = str(ord_type).strip().upper()[:1]
+    best = _positive_int(opponent_best_price_tick)
+    second = _positive_int(opponent_second_price_tick)
+    price = _positive_int(submit_price_tick)
+    if normalized_side not in {"B", "S"} or best is None:
+        return "unknown"
+    if second is None:
+        return "second_level_absent"
+    if normalized_type == "M":
+        return "second_or_deeper"
+    if normalized_type != "L" or price is None:
+        return "unknown"
+    reaches_best = price >= best if normalized_side == "B" else price <= best
+    if not reaches_best:
+        return "unknown"
+    reaches_second = price >= second if normalized_side == "B" else price <= second
+    return "second_or_deeper" if reaches_second else "best_only"
+
+
+def _positive_int(value: object) -> int | None:
+    if value is None or pd.isna(value):
+        return None
+    try:
+        result = int(value)
+    except (TypeError, ValueError):
+        return None
+    return result if result > 0 else None
+
+
+def _second_price(row: pd.Series) -> object:
+    explicit = row.get("opponent_second_price_tick_pre", pd.NA)
+    if not pd.isna(explicit):
+        return explicit
+    side = str(row.get("action_side", row.get("side", ""))).upper()
+    source = "ask_prices_topn_pre" if side == "B" else "bid_prices_topn_pre"
+    values = row.get(source)
+    if isinstance(values, np.ndarray):
+        return int(values[1]) if len(values) > 1 else pd.NA
+    if isinstance(values, (list, tuple)):
+        return int(values[1]) if len(values) > 1 else pd.NA
+    return pd.NA
+
+
+def _attach_c7_geometry_fields(
+    geometry: pd.DataFrame,
+    *,
+    lifecycle: pd.DataFrame | None,
+    event_prestate: pd.DataFrame,
+) -> pd.DataFrame:
+    result = geometry.copy()
+    key_columns = ["date", "code", "channel_no", "order_id"]
+    metadata = pd.DataFrame(index=result.index)
+    if lifecycle is not None:
+        available = [
+            column
+            for column in (*key_columns, "ord_type", "submit_price_tick")
+            if column in lifecycle
+        ]
+        if "order_id" in available:
+            source = lifecycle.loc[:, available].drop_duplicates(key_columns)
+            metadata = result.loc[:, key_columns].merge(
+                source, on=key_columns, how="left", validate="one_to_one"
+            )
+    prestate = event_prestate.loc[
+        event_prestate["event_leg"].astype(str).eq("order")
+    ].copy()
+    prestate["order_id"] = pd.to_numeric(prestate["action_order_id"]).astype("int64")
+    prestate["opponent_second_price_tick_pre"] = prestate.apply(
+        _second_price, axis=1
+    )
+    prestate_join_keys = (
+        key_columns
+        if {"date", "code", "channel_no"}.issubset(prestate.columns)
+        else ["order_id"]
+    )
+    prestate_columns = [
+        *prestate_join_keys,
+        "ord_type",
+        "price_tick",
+        "opponent_second_price_tick_pre",
+    ]
+    available = [column for column in prestate_columns if column in prestate]
+    prestate_source = prestate.loc[:, available].drop_duplicates(prestate_join_keys)
+    state_metadata = result.loc[:, prestate_join_keys].merge(
+        prestate_source, on=prestate_join_keys, how="left", validate="one_to_one"
+    )
+    if metadata.empty:
+        metadata = result.loc[:, key_columns].copy()
+    lifecycle_type = metadata.get("ord_type", pd.Series(pd.NA, index=result.index))
+    lifecycle_price = metadata.get(
+        "submit_price_tick", pd.Series(pd.NA, index=result.index)
+    )
+    state_type = state_metadata.get(
+        "ord_type", pd.Series(pd.NA, index=result.index, dtype="object")
+    )
+    state_price = state_metadata.get(
+        "price_tick", pd.Series(pd.NA, index=result.index, dtype="object")
+    )
+    result["ord_type"] = lifecycle_type.fillna(state_type).astype(str)
+    result["submit_price_tick"] = pd.array(
+        pd.to_numeric(lifecycle_price, errors="coerce").fillna(
+            pd.to_numeric(state_price, errors="coerce")
+        ),
+        dtype="Int64",
+    )
+    result["opponent_second_price_tick_pre"] = pd.array(
+        state_metadata["opponent_second_price_tick_pre"], dtype="Int64"
+    )
+    q = pd.to_numeric(result["submit_qty"], errors="coerce").fillna(0).to_numpy(
+        dtype=np.int64
+    )
+    d_numeric = pd.to_numeric(result["opponent_best_qty_pre"], errors="coerce")
+    d = d_numeric.fillna(0).to_numpy(dtype=np.int64)
+    valid = d_numeric.notna().to_numpy() & (q > 0) & (d > 0)
+    relation = np.full(len(result), "indeterminate", dtype=object)
+    relation[valid & (q < d)] = "Q<D"
+    relation[valid & (q == d)] = "Q=D"
+    relation[valid & (q > d)] = "Q>D"
+    result["q_relation"] = relation
+    result["price_reach"] = [
+        classify_price_reach(
+            side=side,
+            ord_type=order_type,
+            submit_price_tick=submit_price,
+            opponent_best_price_tick=best,
+            opponent_second_price_tick=second,
+        )
+        for side, order_type, submit_price, best, second in zip(
+            result["side"],
+            result["ord_type"],
+            result["submit_price_tick"],
+            result["best_price_tick_pre"],
+            result["opponent_second_price_tick_pre"],
+            strict=True,
+        )
+    ]
+    return result
+
