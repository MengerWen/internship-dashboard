+def test_geometry_emits_ord_type_submit_price_and_int_quantity_relation() -> None:
+    lifecycle, prestate = _fixtures()
+    result = classify_execution_geometry(lifecycle, prestate)
+    assert result["ord_type"].tolist() == ["L", "L", "L", "L"]
+    assert result["submit_price_tick"].tolist() == [101, 101, 102, 99]
+    assert result["q_relation"].tolist() == ["Q=D", "Q<D", "Q>D", "indeterminate"]
+
+
+def test_limit_order_reaching_only_best_is_best_only() -> None:
+    assert classify_price_reach(
+        side="B", ord_type="L", submit_price_tick=101,
+        opponent_best_price_tick=101, opponent_second_price_tick=102,
+    ) == "best_only"
+
+
+def test_limit_order_reaching_second_level_is_second_or_deeper() -> None:
+    assert classify_price_reach(
+        side="S", ord_type="L", submit_price_tick=98,
+        opponent_best_price_tick=99, opponent_second_price_tick=98,
+    ) == "second_or_deeper"
+
+
+def test_market_order_type_reach_uses_szse_semantics() -> None:
+    assert classify_price_reach(
+        side="B", ord_type="M", submit_price_tick=0,
