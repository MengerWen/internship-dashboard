{
  "name": "internship-dashboard",
  "private": true,
  "scripts": {
    "workspace:build": "node scripts/workspace_inventory.cjs --build",
    "nav:check": "node scripts/workspace_inventory.cjs --nav --check",
    "nav:apply": "node scripts/workspace_inventory.cjs --nav --apply",
    "workspace:audit": "node scripts/workspace_inventory.cjs --check",
    "journal:sources": "node scripts/workspace_inventory.cjs --journal",
    "journal:register": "node scripts/workspace_inventory.cjs --journal-register",
    "test": "node --test tests/tag-model.test.cjs tests/tag-api.test.mjs tests/journal-calendar.test.cjs tests/journal-provenance.test.cjs tests/journal-notes.test.cjs tests/journal-selection.test.cjs tests/journal-routing.test.cjs tests/daily-routing.test.cjs",
    "test:browser": "playwright test -c tests/playwright.config.cjs",
    "test:browser:embedded": "playwright test -c tests/isolated-html.config.cjs",
    "dev": "wrangler dev --ip 127.0.0.1",
    "deploy": "powershell.exe -NoLogo -NoProfile -File scripts/publish-site.ps1"
  },
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": { "@playwright/test": "1.63.0", "wrangler": "4.129.0" }
}
