  "narrative": {
    "northStar": "研究编辑台",
    "overview": "暖纸底、深墨文字、清楚的版线和衬线标题构成现有站点的出版物语言。材料密度较高，标题、正文、索引和证据各有位置；层级主要由字号、字体、边界与留白建立。\n\n本文件从现有代码提取，保存已批准的方向 B。研究日志是同一站点的扩展；其方向三「推进图谱」属于栏目方案，不替换全站身份。纸底网格、刊头、细分隔线与编号已有用户选择依据；它们不因通用风格检测的提示而在本次扩展中改写。",
    "keyCharacteristics": [
      "纸色背景与墨色正文承担阅读层级。",
      "自托管的两种衬线字体用于刊头、标题和长文，系统无衬线体用于控件与索引。",
      "近方角、细线和反白选中态组织密集信息。",
      "日志用位置、线型、空实和文字编码数据，珊瑚色标记当前选中或聚焦。"
    ],
    "rules": [
      {
        "name": "The Journal Focus Rule",
        "body": "日志内的珊瑚色只表示当前选中或聚焦；有无汇报与链条身份使用其他编码。此约束不回写为全站旧组件已经完全遵守的事实。",
        "section": "colors"
      },
      {
        "name": "The Small Text Rule",
        "body": "新日志中的说明、计数、表头、证据小字、占位文字和图谱标签使用 `text`；不以透明度削弱这些文字。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 从 `site/css/tokens.css` 复用现有名称与值，修改规范前先核对源码。",
      "**Do** 让日志图谱、清单、日卡使用同一套日期和链条信息，并保留文字证据入口。",
      "**Do** 用纸面、边界和字体共同区分有汇报的日子，用文字标明推断归属。",
      "**Do** 为新增日志小字使用 `text`，保留键盘焦点与窄屏控件尺寸。"
    ],
    "donts": [
      "**Don't** 将六个阶段色改作日志链条色，或把珊瑚色用于日志的汇报分类。",
      "**Don't** 把日志的「推进图谱」构图升级为全站必须使用的页面布局。",
      "**Don't** 为普通日卡添加浮起阴影、装饰图，或另起一套字体与颜色。",
      "**Don't** 把旧刊头的小字和低对比规格当作新增界面的可读性依据。"
    ]
  }
