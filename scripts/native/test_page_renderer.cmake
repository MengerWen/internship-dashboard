set(body "${CMAKE_CURRENT_BINARY_DIR}/page-renderer-test-input.html")
file(WRITE "${body}" "<p>@TITLE_ATTR@ src=\"assets/a\" href='assets/b'</p>")
function(check_page expected mode)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/page-renderer-test-${mode}.html")
  execute_process(COMMAND "${TOOL}" "${mode}" "A<&\"'>" ${ARGN}
    INPUT_FILE "${body}" OUTPUT_FILE "${output}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${mode} failed: ${status}")
  endif()
  file(SHA256 "${output}" digest)
  if(NOT digest STREQUAL expected)
    message(FATAL_ERROR "${mode} output digest: ${digest}, expected: ${expected}")
  endif()
endfunction()
check_page(ee4140b620b04ff0385004d07b132e2e960b942bea0ba1639e792cde1529bf28 daily)
check_page(3312cb393963cf4eec4038a053a34b37414c4278a24e16b464d7005a8de8b314 index "#@BODY@" "x&" "a<>" "@key" "v")

set(daily_root "${CMAKE_CURRENT_BINARY_DIR}/daily source test")
file(MAKE_DIRECTORY "${daily_root}/nested")
file(WRITE "${daily_root}/nested/摘要.html" "<p>原始日报</p>")
function(check_source expected source)
  execute_process(COMMAND "${TOOL}" validate-daily-source "${daily_root}" "${source}"
    RESULT_VARIABLE status)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "daily source ${source}: ${status}, expected: ${expected}")
  endif()
endfunction()
check_source(0 "nested/摘要.html")
check_source(0 "nested/missing.html")
