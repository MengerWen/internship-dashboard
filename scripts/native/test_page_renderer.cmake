set(body "${CMAKE_CURRENT_BINARY_DIR}/page-renderer-test-input.html")
file(WRITE "${body}" "<p>@TITLE_ATTR@ src=\"assets/a\" href='assets/b'</p>")
function(check_page expected mode)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/page-renderer-test-${mode}.html")
  execute_process(COMMAND "${TOOL}" "${mode}" "A<&\"'>" ${ARGN}
    INPUT_FILE "${body}" OUTPUT_FILE "${output}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${mode} failed: ${status}")
  endif()
  file(SHA256 "${output}" digest)
  if(NOT digest STREQUAL expected)
    message(FATAL_ERROR "${mode} output digest: ${digest}, expected: ${expected}")
  endif()
endfunction()
