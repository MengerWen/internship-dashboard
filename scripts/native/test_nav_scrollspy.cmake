set(test_root "${CMAKE_CURRENT_BINARY_DIR}/nav-fixture")
file(MAKE_DIRECTORY "${test_root}/content/daily" "${test_root}/scripts")
file(COPY "${PROJECT_ROOT}/scripts/nav_scrollspy" DESTINATION "${test_root}/scripts")
set(page "${test_root}/content/daily/2026-07-08.show.html")
file(WRITE "${page}" "<html><head></head><body>text</body></html>\n")
foreach(step IN ITEMS check_before apply check_after reapply)
  if(step MATCHES "^check")
    set(mode "--check")
  else()
    set(mode "--apply")
  endif()
  execute_process(COMMAND "${TOOL}" "${mode}" WORKING_DIRECTORY "${test_root}"
    RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE diagnostic)
  if(step STREQUAL "check_before")
    if(NOT status STREQUAL "1" OR NOT result MATCHES "STALE")
      message(FATAL_ERROR "expected a stale page: ${diagnostic}")
    endif()
  elseif(NOT status STREQUAL "0")
    message(FATAL_ERROR "scrollspy failed: ${diagnostic}")
  endif()
  if(step STREQUAL "apply")
    file(SHA256 "${page}" first_hash)
  elseif(step STREQUAL "reapply")
    file(SHA256 "${page}" repeat_hash)
    if(NOT first_hash STREQUAL repeat_hash OR result MATCHES "patched")
      message(FATAL_ERROR "repeated patch changed the page")
    endif()
  endif()
endforeach()
